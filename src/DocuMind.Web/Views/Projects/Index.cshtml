@model IReadOnlyList<ProjectDto>
@{
    ViewData["Title"] = "Projects";
    var search = ViewData["Search"] as string;
    var canCreate = ViewData["CanCreate"] is true;
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <div class="me-auto">
        <h1 class="h3 mb-0">Projects</h1>
        <p class="text-body-secondary mb-0 small">@(isAdmin ? "Every project in the system (you're an Admin)." : "Projects shared with you.")</p>
    </div>
    <form method="get" action="/" class="d-flex" role="search">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="search" name="q" value="@search" class="form-control" placeholder="Search projects" aria-label="Search projects" />
        </div>
    </form>
    @if (canCreate)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal"><i class="bi bi-plus-lg"></i> New project</button>
    }
</div>

@if (Model.Count == 0)
{
    <div class="card border-dashed text-center py-5">
        <div class="card-body">
            <i class="bi bi-folder-x display-5 text-body-secondary"></i>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <h2 class="h5 mt-3">No projects match “@search”.</h2>
            }
            else if (canCreate)
            {
                <h2 class="h5 mt-3">No projects yet</h2>
                <p class="text-body-secondary">Create a project, upload documents, then share it with your team.</p>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal"><i class="bi bi-plus-lg"></i> New project</button>
            }
            else
            {
                <h2 class="h5 mt-3">Nothing shared with you yet</h2>
                <p class="text-body-secondary mb-0">Ask a Manager to add <b>@User.FindFirstValue(ClaimTypes.Email)</b> to a project.</p>
            }
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <a href="/projects/@p.Id" class="card project-card h-100 shadow-sm text-decoration-none text-body">
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <i class="bi bi-folder2 fs-4 text-primary"></i>
                            <div class="flex-grow-1 min-w-0">
                                <h2 class="h6 mb-0 truncate">@p.Name</h2>
                                <div class="small text-body-secondary">Updated @Format.When(p.UpdatedAt)</div>
                            </div>
                            <span class="badge @Format.RoleBadge(p.MyRole)">@(p.MyRole?.ToString() ?? "Admin")</span>
                        </div>
                        <p class="small text-body-secondary truncate mb-3">@(p.Description ?? "No description")</p>
                        <div class="d-flex flex-wrap gap-1 small">
                            <span class="badge rounded-pill text-bg-light border"><i class="bi bi-file-earmark"></i> @p.Documents.Total documents</span>
                            @if (p.Documents.Queued + p.Documents.Processing > 0)
                            {
                                <span class="badge rounded-pill text-bg-info">@(p.Documents.Queued + p.Documents.Processing) processing</span>
                            }
                            @if (p.Documents.Failed > 0)
                            {
                                <span class="badge rounded-pill text-bg-danger">@p.Documents.Failed failed</span>
                            }
                            <span class="badge rounded-pill text-bg-light border">@Format.Bytes(p.TotalSizeBytes)</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@if (canCreate)
{
    <div class="modal fade" id="createProjectModal" tabindex="-1" aria-labelledby="createProjectTitle" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="/projects" class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createProjectTitle">New project</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="projName">Name</label>
                        <input id="projName" name="name" class="form-control" required maxlength="120" />
                    </div>
                    <div>
                        <label class="form-label" for="projDesc">Description <span class="text-body-secondary">(optional)</span></label>
                        <textarea id="projDesc" name="description" class="form-control" rows="3" maxlength="1000"></textarea>
                    </div>
                    <p class="form-text mb-0 mt-3">You'll be the project's Owner and can share it with others.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create project</button>
                </div>
            </form>
        </div>
    </div>
}
