@model WorkspaceViewModel
@{
    var p = Model.Project;
    var a = Model.Access;
    var f = Model.Filter;
    var docs = Model.Documents;
    var here = Model.CurrentUrl;
    var folder = Model.SelectedFolder;
    var collection = Model.SelectedCollection;
    var manageable = Model.ManageableCollections;
    ViewData["Title"] = p.Name;

    string Url(Action<WorkspaceFilter> change) => f.With(change).ToUrl(p.Id);
    string ScopeUrl(Guid? folderId = null, bool root = false, Guid? collectionId = null) =>
        f.With(x => { x.Folder = folderId; x.Root = root; x.Collection = collectionId; x.Page = 1; if (folderId is null) x.Sub = false; }).ToUrl(p.Id);
    string SortUrl(DocumentSort sort) => Url(x => { x.Desc = x.Sort == sort ? !x.Desc : sort is DocumentSort.UploadedAt or DocumentSort.Size; x.Sort = sort; x.Page = 1; });
    string SortIcon(DocumentSort sort) => f.Sort != sort ? "" : f.Desc ? "bi-caret-down-fill" : "bi-caret-up-fill";
}

@* ===== Header ===== *@
<nav aria-label="breadcrumb">
    <ol class="breadcrumb small mb-2">
        <li class="breadcrumb-item"><a href="/">Projects</a></li>
        <li class="breadcrumb-item active" aria-current="page">@p.Name</li>
    </ol>
</nav>

<div class="d-flex flex-wrap align-items-start gap-3 mb-4">
    <div class="me-auto">
        <h1 class="h3 mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-folder2-open text-primary"></i> @p.Name
            <span class="badge @Format.RoleBadge(p.MyRole) fs-6 fw-normal">@(p.MyRole?.ToString() ?? "Admin")</span>
        </h1>
        @if (!string.IsNullOrWhiteSpace(p.Description))
        {
            <p class="text-body-secondary mb-0">@p.Description</p>
        }
    </div>
    <div class="d-flex gap-2">
        @if (a.CanEdit)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal"><i class="bi bi-cloud-arrow-up"></i> Upload</button>
        }
        <a class="btn btn-outline-secondary" href="/projects/@p.Id/members"><i class="bi bi-people"></i> Members</a>
        @if (a.IsOwner)
        {
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-gear"></i> Project</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editProjectModal"><i class="bi bi-pencil"></i> Rename / describe</button></li>
                    <li><a class="dropdown-item" href="/audit?projectId=@p.Id"><i class="bi bi-shield-check"></i> Audit log</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteProjectModal"><i class="bi bi-trash"></i> Delete project</button></li>
                </ul>
            </div>
        }
    </div>
</div>

<div class="row g-4">
    @* ===== Left: folders and collections ===== *@
    <div class="col-lg-3">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex align-items-center">
                <span class="fw-semibold me-auto"><i class="bi bi-diagram-3"></i> Folders</span>
                @if (a.CanEdit)
                {
                    <button class="btn btn-sm btn-link p-0" data-bs-toggle="modal" data-bs-target="#newFolderModal" title="New folder" aria-label="New folder"><i class="bi bi-folder-plus fs-5"></i></button>
                }
            </div>
            <div class="card-body p-2 side-nav">
                <div class="list-group list-group-flush mb-1">
                    <a href="@ScopeUrl()" class="list-group-item list-group-item-action @(folder is null && !f.Root && collection is null ? "active" : "")">
                        <i class="bi bi-files"></i> All documents <span class="count float-end">@p.Documents.Total</span>
                    </a>
                    <a href="@ScopeUrl(root: true)" class="list-group-item list-group-item-action @(f.Root && folder is null ? "active" : "")">
                        <i class="bi bi-house"></i> Project root
                    </a>
                </div>
                @{
                    void Tree(IEnumerable<FolderTreeNode> nodes)
                    {
                        <ul class="folder-tree">
                            @foreach (var n in nodes)
                            {
                                <li>
                                    <a href="@ScopeUrl(folderId: n.Id)" class="list-group-item list-group-item-action d-flex align-items-center @(f.Folder == n.Id ? "active" : "")">
                                        <i class="bi @(f.Folder == n.Id ? "bi-folder2-open" : "bi-folder") me-1"></i>
                                        <span class="truncate me-auto">@n.Name</span>
                                        <span class="count">@n.TotalDocumentCount</span>
                                    </a>
                                    @if (n.Children.Count > 0)
                                    {
                                        Tree(n.Children);
                                    }
                                </li>
                            }
                        </ul>
                    }
                    Tree(Model.Folders);
                }
                @if (Model.Folders.Count == 0)
                {
                    <p class="small text-body-secondary px-2 mb-1">No folders yet.</p>
                }
            </div>
            @if (folder is not null && a.CanEdit)
            {
                <div class="card-footer bg-white d-flex flex-wrap gap-1">
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#renameFolderModal" data-field-name="@folder.Path.Split(" / ").Last()"><i class="bi bi-pencil"></i> Rename</button>
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#moveFolderModal" data-exclude="@string.Join(",", folder.Subtree)"><i class="bi bi-arrows-move"></i> Move</button>
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteFolderModal"><i class="bi bi-trash"></i></button>
                </div>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex align-items-center">
                <span class="fw-semibold me-auto"><i class="bi bi-collection"></i> Collections</span>
                <button class="btn btn-sm btn-link p-0" data-bs-toggle="modal" data-bs-target="#collectionModal" data-action="/projects/@p.Id/collections"
                        data-title="New collection" data-field-name="" data-field-description="" data-field-visibility="Private" title="New collection" aria-label="New collection">
                    <i class="bi bi-plus-square fs-5"></i>
                </button>
            </div>
            <div class="card-body p-2 side-nav">
                @if (Model.Collections.Count == 0)
                {
                    <p class="small text-body-secondary px-2 mb-1">No collections yet. Create a private one to curate documents, then share it.</p>
                }
                <div class="list-group list-group-flush">
                    @foreach (var c in Model.Collections)
                    {
                        var canManage = a.CanManage(c, Model.MyId);
                        <div class="list-group-item list-group-item-action d-flex align-items-center p-0 @(f.Collection == c.Id ? "active" : "")">
                            <a href="@ScopeUrl(collectionId: c.Id)" class="d-flex align-items-center flex-grow-1 min-w-0 text-reset text-decoration-none py-2 ps-2">
                                <i class="bi @(c.Visibility == CollectionVisibility.Private ? "bi-lock" : "bi-people") me-1" title="@c.Visibility"></i>
                                <span class="truncate me-auto">@c.Name</span>
                                <span class="count me-1">@c.DocumentCount</span>
                            </a>
                            @if (canManage)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-body-secondary px-1" data-bs-toggle="dropdown" aria-label="Collection actions"><i class="bi bi-three-dots-vertical"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/collections/@c.Id/shares"><i class="bi bi-share"></i> Share…</a></li>
                                        <li>
                                            <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#collectionModal" data-action="/collections/@c.Id/edit"
                                                    data-title="Edit collection" data-field-name="@c.Name" data-field-description="@c.Description" data-field-visibility="@c.Visibility">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form method="post" action="/collections/@c.Id/delete" onsubmit="return confirm('Delete the collection “@c.Name”? Its documents are kept.');">
                                                <input type="hidden" name="projectId" value="@p.Id" />
                                                <button class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ===== Right: documents ===== *@
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <form method="get" action="/projects/@p.Id" class="row g-2 align-items-center">
                    @if (f.Folder is { } fid) { <input type="hidden" name="folder" value="@fid" /> }
                    @if (f.Root) { <input type="hidden" name="root" value="true" /> }
                    @if (f.Collection is { } cid) { <input type="hidden" name="collection" value="@cid" /> }
                    <input type="hidden" name="sort" value="@f.Sort" />
                    <input type="hidden" name="desc" value="@(f.Desc ? "true" : "false")" />

                    <div class="col-12 col-xl-auto me-xl-auto">
                        <h2 class="h6 mb-0 truncate"><i class="bi @(collection is not null ? "bi-collection" : folder is not null ? "bi-folder2-open" : "bi-files")"></i> @Model.ScopeTitle</h2>
                        @if (collection is not null)
                        {
                            <div class="small text-body-secondary">@(collection.Visibility == CollectionVisibility.Private ? "Private collection" : "Visible to the whole project")@(string.IsNullOrWhiteSpace(collection.Description) ? "" : $" · {collection.Description}")</div>
                        }
                    </div>
                    <div class="col-12 col-sm">
                        <input type="search" name="q" value="@f.Q" class="form-control form-control-sm" placeholder="Filter by file name" aria-label="Filter by file name" />
                    </div>
                    <div class="col-6 col-sm-auto">
                        <select name="status" class="form-select form-select-sm" aria-label="Status" onchange="this.form.submit()">
                            <option value="">Any status</option>
                            @foreach (var s in Enum.GetValues<DocumentStatus>())
                            {
                                <option value="@s" selected="@(f.Status == s)">@s</option>
                            }
                        </select>
                    </div>
                    @if (folder is not null)
                    {
                        <div class="col-6 col-sm-auto">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="sub" name="sub" value="true" checked="@f.Sub" onchange="this.form.submit()" />
                                <label class="form-check-label small" for="sub">Include subfolders</label>
                            </div>
                        </div>
                    }
                    <div class="col-auto"><button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i></button></div>
                </form>
            </div>

            @if (docs.Items.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox display-6 text-body-secondary"></i>
                    <p class="mt-2 mb-3 text-body-secondary">No documents here@(string.IsNullOrWhiteSpace(f.Q) && f.Status is null ? "" : " match the filters").</p>
                    @if (a.CanEdit && collection is null)
                    {
                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal"><i class="bi bi-cloud-arrow-up"></i> Upload documents</button>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover doc-table mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th><a class="text-reset text-decoration-none" href="@SortUrl(DocumentSort.Name)">Name <i class="bi @SortIcon(DocumentSort.Name)"></i></a></th>
                                <th><a class="text-reset text-decoration-none" href="@SortUrl(DocumentSort.Status)">Status <i class="bi @SortIcon(DocumentSort.Status)"></i></a></th>
                                <th class="text-end"><a class="text-reset text-decoration-none" href="@SortUrl(DocumentSort.Size)">Size <i class="bi @SortIcon(DocumentSort.Size)"></i></a></th>
                                <th class="d-none d-md-table-cell"><a class="text-reset text-decoration-none" href="@SortUrl(DocumentSort.UploadedAt)">Uploaded <i class="bi @SortIcon(DocumentSort.UploadedAt)"></i></a></th>
                                <th class="text-end"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in docs.Items)
                            {
                                <tr>
                                    <td class="doc-name">
                                        <a href="/documents/@d.Id" class="d-flex align-items-center gap-2 text-decoration-none">
                                            <i class="bi @Format.FileIcon(d.FileName) fs-5"></i><span class="truncate">@d.FileName</span>
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge @Format.StatusBadge(d.Status)" @(d.FailureReason is null ? "" : "data-bs-toggle=tooltip") title="@d.FailureReason">@d.Status</span>
                                    </td>
                                    <td class="text-end small text-nowrap">@Format.Bytes(d.SizeBytes)</td>
                                    <td class="small text-nowrap d-none d-md-table-cell">@Format.When(d.UploadedAt)</td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light" data-bs-toggle="dropdown" aria-label="Actions for @d.FileName"><i class="bi bi-three-dots"></i></button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" href="/documents/@d.Id"><i class="bi bi-eye"></i> Open</a></li>
                                                <li><a class="dropdown-item" href="/documents/@d.Id/download"><i class="bi bi-download"></i> Download</a></li>
                                                @if (manageable.Count > 0)
                                                {
                                                    <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#addToCollectionModal" data-field-document-id="@d.Id"><i class="bi bi-collection"></i> Add to collection…</button></li>
                                                }
                                                @if (collection is not null && a.CanManage(collection, Model.MyId))
                                                {
                                                    <li>
                                                        <form method="post" action="/collections/@collection.Id/documents/@d.Id/remove">
                                                            <input type="hidden" name="returnUrl" value="@here" />
                                                            <button class="dropdown-item"><i class="bi bi-dash-circle"></i> Remove from collection</button>
                                                        </form>
                                                    </li>
                                                }
                                                @if (a.CanEdit)
                                                {
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#renameDocModal" data-action="/documents/@d.Id/rename" data-field-file-name="@d.FileName"><i class="bi bi-pencil"></i> Rename</button></li>
                                                    <li><button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#moveDocModal" data-action="/documents/@d.Id/move" data-field-folder-id="@d.FolderId"><i class="bi bi-arrows-move"></i> Move</button></li>
                                                    @if (d.Status is DocumentStatus.Completed or DocumentStatus.Failed)
                                                    {
                                                        <li>
                                                            <form method="post" action="/documents/@d.Id/reprocess">
                                                                <input type="hidden" name="returnUrl" value="@here" />
                                                                <button class="dropdown-item"><i class="bi bi-arrow-repeat"></i> Reprocess</button>
                                                            </form>
                                                        </li>
                                                    }
                                                    <li>
                                                        <form method="post" action="/documents/@d.Id/delete" onsubmit="return confirm('Delete “@d.FileName”? This cannot be undone.');">
                                                            <input type="hidden" name="projectId" value="@p.Id" />
                                                            <input type="hidden" name="returnUrl" value="@here" />
                                                            <button class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white d-flex flex-wrap align-items-center gap-2 small">
                    <span class="text-body-secondary me-auto">@docs.TotalCount document@(docs.TotalCount == 1 ? "" : "s")</span>
                    @if (docs.TotalPages > 1)
                    {
                        <nav aria-label="Document pages">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(docs.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url(x => x.Page = docs.Page - 1)">Previous</a></li>
                                <li class="page-item disabled"><span class="page-link">Page @docs.Page of @docs.TotalPages</span></li>
                                <li class="page-item @(docs.Page >= docs.TotalPages ? "disabled" : "")"><a class="page-link" href="@Url(x => x.Page = docs.Page + 1)">Next</a></li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ===== Modals ===== *@
@{
    var destination = folder?.Path ?? "Project root";
}
@if (a.CanEdit)
{
    <div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="/projects/@p.Id/upload" enctype="multipart/form-data" class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">Upload documents</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <p class="small mb-3">Uploading to <b>@destination</b>. PDF, DOCX, TXT and Markdown — up to 20 files, 50 MB each.</p>
                    @if (folder is not null) { <input type="hidden" name="folderId" value="@folder.Id" /> }
                    <input type="hidden" name="destination" value="@destination" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <input type="file" name="files" class="form-control mb-3" multiple required accept=".pdf,.docx,.txt,.md" />
                    @if (manageable.Count > 0)
                    {
                        <label class="form-label small" for="uploadCollection">Also add to a collection (optional)</label>
                        <select id="uploadCollection" name="collectionId" class="form-select">
                            <option value="">— none —</option>
                            @foreach (var c in manageable)
                            {
                                <option value="@c.Id" selected="@(collection?.Id == c.Id)">@c.Name</option>
                            }
                        </select>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" onclick="this.disabled=true;this.innerHTML='Uploading…';this.form.submit();"><i class="bi bi-cloud-arrow-up"></i> Upload</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="newFolderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <form method="post" action="/projects/@p.Id/folders" class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">New folder</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <input type="hidden" name="returnUrl" value="@here" />
                    <label class="form-label small" for="newFolderName">Name</label>
                    <input id="newFolderName" name="name" class="form-control mb-3" required maxlength="120" />
                    <label class="form-label small" for="newFolderParent">Inside</label>
                    <select id="newFolderParent" name="parentId" class="form-select">
                        <option value="">Project root</option>
                        @foreach (var o in Model.FolderOptions)
                        {
                            <option value="@o.Id" selected="@(folder?.Id == o.Id)">@o.Path</option>
                        }
                    </select>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create</button></div>
            </form>
        </div>
    </div>

    @if (folder is not null)
    {
        <div class="modal fade" id="renameFolderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-sm">
                <form method="post" action="/folders/@folder.Id/rename" class="modal-content">
                    <div class="modal-header"><h2 class="modal-title h5">Rename folder</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <input type="hidden" name="returnUrl" value="@here" />
                        <input name="name" class="form-control" required maxlength="120" aria-label="Folder name" />
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="moveFolderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-sm">
                <form method="post" action="/folders/@folder.Id/move" class="modal-content">
                    <div class="modal-header"><h2 class="modal-title h5">Move “@folder.Path.Split(" / ").Last()”</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <input type="hidden" name="returnUrl" value="@here" />
                        <label class="form-label small" for="moveFolderParent">Into</label>
                        <select id="moveFolderParent" name="parentId" class="form-select">
                            <option value="">Project root</option>
                            @foreach (var o in Model.FolderOptions)
                            {
                                <option value="@o.Id">@o.Path</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Move</button></div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="deleteFolderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form method="post" action="/folders/@folder.Id/delete" class="modal-content">
                    <div class="modal-header"><h2 class="modal-title h5">Delete “@folder.Path.Split(" / ").Last()”?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body">
                        <input type="hidden" name="projectId" value="@p.Id" />
                        <p>An empty folder is simply removed.</p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="recursive" value="true" id="recursiveDelete" />
                            <label class="form-check-label text-danger" for="recursiveDelete">Also delete every subfolder and document inside it (cannot be undone)</label>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete folder</button></div>
                </form>
            </div>
        </div>
    }

    <div class="modal fade" id="renameDocModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">Rename document</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <input type="hidden" name="returnUrl" value="@here" />
                    <input name="fileName" class="form-control" required maxlength="255" aria-label="File name" />
                    <div class="form-text">The file extension is kept.</div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Rename</button></div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="moveDocModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <form method="post" class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">Move document</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <input type="hidden" name="returnUrl" value="@here" />
                    <select name="folderId" class="form-select" aria-label="Destination folder">
                        <option value="">Project root</option>
                        @foreach (var o in Model.FolderOptions)
                        {
                            <option value="@o.Id">@o.Path</option>
                        }
                    </select>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Move</button></div>
            </form>
        </div>
    </div>
}

@if (manageable.Count > 0)
{
    <div class="modal fade" id="addToCollectionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <form method="post" class="modal-content" onsubmit="this.action='/collections/' + this.elements.collection.value + '/documents';">
                <div class="modal-header"><h2 class="modal-title h5">Add to collection</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <input type="hidden" name="documentId" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <select name="collection" class="form-select" aria-label="Collection">
                        @foreach (var c in manageable)
                        {
                            <option value="@c.Id">@c.Name (@c.Visibility.ToString().ToLowerInvariant())</option>
                        }
                    </select>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Add</button></div>
            </form>
        </div>
    </div>
}

<div class="modal fade" id="collectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">Collection</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <input type="hidden" name="returnUrl" value="@here" />
                <label class="form-label small" for="collName">Name</label>
                <input id="collName" name="name" class="form-control mb-3" required maxlength="120" />
                <label class="form-label small" for="collDesc">Description <span class="text-body-secondary">(optional)</span></label>
                <textarea id="collDesc" name="description" class="form-control mb-3" rows="2" maxlength="1000"></textarea>
                <label class="form-label small" for="collVisibility">Who can see it</label>
                <select id="collVisibility" name="visibility" class="form-select">
                    <option value="Private">Private — only you and the people you share it with</option>
                    <option value="Project" disabled="@(!a.CanEdit)">Project — everyone in @p.Name@(a.CanEdit ? "" : " (needs Editor role)")</option>
                </select>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@if (a.IsOwner)
{
    <div class="modal fade" id="editProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="/projects/@p.Id/edit" class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">Edit project</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <label class="form-label small" for="editProjName">Name</label>
                    <input id="editProjName" name="name" class="form-control mb-3" required maxlength="120" value="@p.Name" />
                    <label class="form-label small" for="editProjDesc">Description</label>
                    <textarea id="editProjDesc" name="description" class="form-control" rows="3" maxlength="1000">@p.Description</textarea>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="deleteProjectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="/projects/@p.Id/delete" class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5">Delete “@p.Name”?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <p>The project must be empty unless you tick the box below.</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="force" value="true" id="forceDelete" />
                        <label class="form-check-label text-danger" for="forceDelete">Delete all @p.Documents.Total documents, folders, collections and chats too (cannot be undone)</label>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete project</button></div>
            </form>
        </div>
    </div>
}
