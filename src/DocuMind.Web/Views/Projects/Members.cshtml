@model MembersViewModel
@{
    var p = Model.Project;
    var owner = Model.Access.IsOwner;
    var amMember = Model.Members.Any(m => m.UserId == Model.MyId);
    ViewData["Title"] = $"Members · {p.Name}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small mb-2">
        <li class="breadcrumb-item"><a href="/">Projects</a></li>
        <li class="breadcrumb-item"><a href="/projects/@p.Id">@p.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Members</li>
    </ol>
</nav>

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <div class="me-auto">
        <h1 class="h3 mb-0">Members</h1>
        <p class="small text-body-secondary mb-0">Everyone here can read the project's documents. Roles decide what else they can do.</p>
    </div>
    @if (amMember)
    {
        <form method="post" action="/projects/@p.Id/members/@Model.MyId/remove" onsubmit="return confirm('Leave @p.Name? You will lose access to its documents.');">
            <button class="btn btn-outline-danger"><i class="bi bi-box-arrow-left"></i> Leave project</button>
        </form>
    }
</div>

<div class="row g-4">
    <div class="@(owner ? "col-lg-8" : "col-12")">
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small"><tr><th>Person</th><th style="width:210px">Role</th><th>Added</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.Members)
                        {
                            var isMe = m.UserId == Model.MyId;
                            <tr>
                                <td>
                                    <div class="fw-semibold">@m.DisplayName @(isMe ? "(you)" : "")</div>
                                    <div class="small text-body-secondary">@m.Email</div>
                                </td>
                                <td>
                                    @if (owner)
                                    {
                                        <form method="post" action="/projects/@p.Id/members/@m.UserId/role">
                                            <select name="role" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Role for @m.DisplayName">
                                                @foreach (var r in Enum.GetValues<ProjectRole>())
                                                {
                                                    <option value="@r" selected="@(m.Role == r)">@r</option>
                                                }
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge @Format.RoleBadge(m.Role)">@m.Role</span>
                                    }
                                </td>
                                <td class="small text-nowrap">@Format.When(m.AddedAt)</td>
                                <td class="text-end">
                                    @if (owner && !isMe)
                                    {
                                        <form method="post" action="/projects/@p.Id/members/@m.UserId/remove" onsubmit="return confirm('Remove @m.DisplayName from the project?');">
                                            <button class="btn btn-sm btn-outline-danger" aria-label="Remove @m.DisplayName"><i class="bi bi-person-dash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (owner)
    {
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h6 mb-3"><i class="bi bi-person-plus"></i> Add a member</h2>
                    <form method="post" action="/projects/@p.Id/members">
                        <label class="form-label small" for="memberEmail">Email address</label>
                        <input id="memberEmail" name="email" type="email" class="form-control mb-3" required placeholder="colleague@example.com" />
                        <label class="form-label small" for="memberRole">Role</label>
                        <select id="memberRole" name="role" class="form-select mb-3">
                            <option value="Viewer">Viewer</option>
                            <option value="Editor">Editor</option>
                            <option value="Owner">Owner</option>
                        </select>
                        <button type="submit" class="btn btn-primary w-100">Add member</button>
                        <div class="form-text">They need an account already.</div>
                    </form>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body small">
                    <h2 class="h6">Roles</h2>
                    <p class="mb-2"><span class="badge text-bg-secondary">Viewer</span> read, preview, download, search and chat.</p>
                    <p class="mb-2"><span class="badge text-bg-success">Editor</span> also upload, rename, move, delete and organize folders.</p>
                    <p class="mb-0"><span class="badge text-bg-primary">Owner</span> also manage members, the project and its audit log.</p>
                </div>
            </div>
        </div>
    }
</div>
