@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-4 text-body-secondary"></i>
    <h1 class="h4 mt-3">Something went wrong</h1>
    <p class="text-body-secondary">An unexpected error occurred. Request id: <code>@System.Diagnostics.Activity.Current?.Id</code></p>
    <a href="/" class="btn btn-outline-primary mt-2">Back to projects</a>
</div>
