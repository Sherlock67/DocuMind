@model UsersViewModel
@{
    ViewData["Title"] = "Users";
    var users = Model.Users;
    var here = $"/admin/users?q={Uri.EscapeDataString(Model.Search ?? "")}&page={users.Page}";
}

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
    <div class="me-auto">
        <h1 class="h3 mb-0">Users</h1>
        <p class="small text-body-secondary mb-0">@users.TotalCount account@(users.TotalCount == 1 ? "" : "s"). Role and status changes apply to open sessions within seconds.</p>
    </div>
    <form method="get" action="/admin/users" role="search">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="search" name="q" value="@Model.Search" class="form-control" placeholder="Name or email" aria-label="Search users" />
        </div>
    </form>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal"><i class="bi bi-person-plus"></i> New user</button>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light small"><tr><th>User</th><th style="width:170px">Role</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in users.Items)
                {
                    var isMe = u.Id == Model.MyId;
                    <tr class="@(u.IsActive ? "" : "text-body-secondary")">
                        <td>
                            <div class="fw-semibold">@u.DisplayName @(isMe ? "(you)" : "")</div>
                            <div class="small">@u.Email</div>
                        </td>
                        <td>
                            <form method="post" action="/admin/users/@u.Id/role">
                                <input type="hidden" name="returnUrl" value="@here" />
                                <select name="role" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Role for @u.DisplayName">
                                    @foreach (var r in Enum.GetValues<UserRole>())
                                    {
                                        <option value="@r" selected="@(u.Role == r)">@r</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td>@if (u.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Deactivated</span> }</td>
                        <td class="small text-nowrap">@Format.When(u.LastLoginAt)</td>
                        <td class="text-end">
                            @if (!isMe)
                            {
                                <form method="post" action="/admin/users/@u.Id/active"
                                      onsubmit="return @(u.IsActive ? $"confirm('Deactivate {u.DisplayName}? They will be signed out everywhere.')" : "true");">
                                    <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                    <input type="hidden" name="returnUrl" value="@here" />
                                    <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Deactivate" : "Reactivate")</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (users.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(users.Page <= 1 ? "disabled" : "")"><a class="page-link" href="/admin/users?q=@Model.Search&page=@(users.Page - 1)">Previous</a></li>
                <li class="page-item disabled"><span class="page-link">Page @users.Page of @users.TotalPages</span></li>
                <li class="page-item @(users.Page >= users.TotalPages ? "disabled" : "")"><a class="page-link" href="/admin/users?q=@Model.Search&page=@(users.Page + 1)">Next</a></li>
            </ul>
        </div>
    }
</div>

<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" action="/admin/users" class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">New user</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <label class="form-label small" for="newUserName">Display name</label>
                <input id="newUserName" name="displayName" class="form-control mb-3" required maxlength="100" />
                <label class="form-label small" for="newUserEmail">Email</label>
                <input id="newUserEmail" name="email" type="email" class="form-control mb-3" required />
                <label class="form-label small" for="newUserPassword">Initial password</label>
                <input id="newUserPassword" name="password" type="password" class="form-control" required minlength="10" autocomplete="new-password" />
                <div class="form-text mb-3">At least 10 characters with upper- and lower-case letters and a digit. Ask them to change it.</div>
                <label class="form-label small" for="newUserRole">Role</label>
                <select id="newUserRole" name="role" class="form-select">
                    <option value="User">User — works in projects shared with them</option>
                    <option value="Manager">Manager — can also create projects</option>
                    <option value="Admin">Admin — full access</option>
                </select>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create user</button></div>
        </form>
    </div>
</div>
